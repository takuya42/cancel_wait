rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid));
    }
    function isOwner(organizationId) {
      return isMember(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/members/$(userId)).data.role == 'owner';
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'owner';
      allow read: if isMember(organizationId);
      allow update: if isOwner(organizationId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(organizationId);

      match /members/{userId} {
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid == request.auth.uid;
        allow read: if isMember(organizationId);
        allow update, delete: if isOwner(organizationId);
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
