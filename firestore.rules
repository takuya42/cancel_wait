rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(organizationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid));
    }
    function isOwner(organizationId) {
      return isMember(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'owner';
    }
    function validEntry() {
      return request.resource.data.keys().hasOnly([
          'date', 'amount', 'category', 'memo', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.date is timestamp
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 100
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 2000;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/members/$(userId)).data.role == 'owner';
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)).data.role == 'owner';
      allow read: if isMember(organizationId);
      allow update: if isOwner(organizationId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(organizationId);

      match /members/{userId} {
        allow create: if signedIn()
          && userId == request.auth.uid
          && request.resource.data.role == 'owner'
          && getAfter(/databases/$(database)/documents/organizations/$(organizationId)).data.ownerUid == request.auth.uid;
        allow read: if isMember(organizationId);
        allow update, delete: if isOwner(organizationId);
      }

      // Financial data is isolated below an organization. Membership is
      // checked for every read and write, preventing cross-organization access.
      match /sales/{saleId} {
        allow read, delete: if isMember(organizationId);
        allow create, update: if isMember(organizationId) && validEntry();
      }
      match /expenses/{expenseId} {
        allow read, delete: if isMember(organizationId);
        allow create, update: if isMember(organizationId) && validEntry();
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
